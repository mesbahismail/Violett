{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "violett",
  "homepage": "https://github.com/mesbahismail/Violett",
  "items": [
    {
      "name": "violett-saas-dashboard",
      "type": "registry:template",
      "title": "Violett SaaS Dashboard",
      "description": "A complete, responsive SaaS workspace dashboard with analytics, orders, products, activity, and calendar views.",
      "dependencies": [
        "lucide-react"
      ],
      "files": [
        {
          "path": "src/app/page.tsx",
          "type": "registry:page",
          "target": "app/page.tsx"
        },
        {
          "path": "src/app/globals.css",
          "type": "registry:style",
          "target": "app/globals.css"
        },
        {
          "path": "public/violett.svg",
          "type": "registry:file",
          "target": "public/violett.svg"
        },
        {
          "path": "src/app/store-data.ts",
          "type": "registry:file",
          "target": "app/store-data.ts"
        },
        {
          "path": "src/app/components/side-panel.tsx",
          "type": "registry:file",
          "target": "app/components/side-panel.tsx"
        }
      ]
    }
  ]
}
